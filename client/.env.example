# The ONLY build-time variable the client needs.
# Leave blank in development to use Vite's proxy (keeps cookies first-party).
# In production set it to the API origin, e.g. https://api.thepurplepanther.in
VITE_API_BASE_URL=

# Origin serving the bundled theme (css, fonts, images) at /frontend.
# Blank uses the same origin, which the dev proxy forwards to the API.
VITE_THEME_URL=
