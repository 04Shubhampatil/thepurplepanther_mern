# The Purple Panther — server environment
#
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every name below is traced to a real usage site — see docs/env-mapping.md.
# Values are intentionally blank: this file must never carry a secret.

# ---------------------------------------------------------------- app
NODE_ENV=development
PORT=5000
APP_NAME="The Purple Panther"

# Public origin of the API itself
APP_URL=http://localhost:5000

# React origin — used for CORS and for links inside transactional emails
FRONTEND_URL=http://localhost:5173

# IANA timezone. Production runs Asia/Kolkata; changing it shifts order timestamps,
# coupon start/end windows and delivery dates.
TZ=Asia/Kolkata

LOG_LEVEL=info

# ---------------------------------------------------------------- database
# mysql://USER:PASSWORD@HOST:3306/DATABASE
# DATABASE_URL      -> the database the API serves
# DATABASE_URL_DEV  -> local restored copy; used by every Prisma CLI command.
# Never point a CLI command that can write schema at production.
DATABASE_URL=
DATABASE_URL_DEV=

# ---------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Signs the guest-cart cookie (guests have no JWT but still have a cart)
SESSION_SECRET=

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ---------------------------------------------------------------- payments
# KEY_ID is public — it reaches the browser to open Razorpay checkout.
# KEY_SECRET is server-only: basic auth + HMAC signature verification.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CURRENCY=INR

# ---------------------------------------------------------------- mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="The Purple Panther"
# Order notifications. Falls back to MAIL_FROM_ADDRESS when blank.
MAIL_ADMIN_ADDRESS=

# ---------------------------------------------------------------- meta conversions api
# Disabled unless ENABLED is true AND both dataset id and token are set.
# Failures are always logged and swallowed — Meta must never break checkout.
META_CAPI_ENABLED=false
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_API_VERSION=v26.0
META_CAPI_TEST_EVENT_CODE=
META_CAPI_TIMEOUT=4

# ---------------------------------------------------------------- meta product catalog
# REQUIRED. The Laravel app left this unset, which silently disabled the token check and
# left the whole catalogue publicly downloadable (audit R1). Here it is mandatory:
# the server refuses to boot without it.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_CATALOG_FEED_TOKEN=
META_CATALOG_CURRENCY=INR
META_CATALOG_DEFAULT_BRAND=

# ---------------------------------------------------------------- storage
# Storage is LOCAL, not S3. Laravel ran FILESYSTEM_DISK=public with the tree rooted at
# public/storage. Point STORAGE_ROOT at that same directory so existing image rows keep
# resolving and both apps can serve each other's uploads during the parallel run.
STORAGE_ROOT=
# Public URL prefix for that tree, no trailing slash (e.g. https://thepurplepanther.in/storage)
MEDIA_BASE_URL=http://localhost:5000/storage

# ---------------------------------------------------------------- rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
